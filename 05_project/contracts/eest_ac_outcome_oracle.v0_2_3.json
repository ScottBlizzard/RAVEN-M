{
  "schema_version": "eest_ac_outcome_oracle.v0_2_3",
  "terminal_window": 2,
  "decision_vocabulary": ["accept", "reject", "uncertain"],
  "confidence": {
    "accept": {"label": "high", "value": 0.95},
    "reject": {"label": "high", "value": 0.95},
    "uncertain": {"label": "low", "value": 0.2}
  },
  "input": {
    "required": ["trace_id", "action_class", "action", "resolver", "pre", "post"],
    "additional_properties": false,
    "action_classes": ["scroll", "open_app", "navigation_press"],
    "observation_required": [
      "pixel_sha256",
      "a11y_available",
      "a11y_sha256",
      "page_content_sha256",
      "package_names",
      "activity",
      "route_signature"
    ],
    "resolver_required": ["target_packages", "target_activities", "provenance_sha256"]
  },
  "generic_stability": {
    "required_terminal_fields": ["package_names", "route_signature", "a11y_sha256", "page_content_sha256"],
    "require_terminal_a11y": true,
    "pixel_stability_required": false,
    "semantic_instability_decision": "reject",
    "missing_critical_decision": "uncertain"
  },
  "policies": {
    "scroll": {
      "accept_rule": "SCROLL_STABLE_A11Y_CHANGE",
      "required_witnesses": [
        "pre_a11y_available",
        "terminal_semantics_stable",
        "same_route_context",
        "stable_page_content_changed"
      ],
      "optional_witnesses": ["terminal_pixels_stable", "pixels_changed"],
      "vetoes": [
        "context_transition",
        "terminal_semantic_instability",
        "contradictory_context_identity",
        "stable_no_semantic_change",
        "pixel_only_change"
      ],
      "missing_behavior": "uncertain"
    },
    "open_app": {
      "accept_rule": "OPEN_APP_STABLE_RESOLVER_TARGET",
      "required_witnesses": [
        "resolver_target_available",
        "terminal_semantics_stable",
        "terminal_target_match",
        "not_already_target_noop"
      ],
      "optional_witnesses": ["activity_target_match", "page_content_changed", "terminal_pixels_stable", "pixels_changed"],
      "vetoes": [
        "wrong_target",
        "already_target_noop",
        "terminal_semantic_instability",
        "contradictory_context_identity",
        "pixel_only_change"
      ],
      "missing_behavior": "uncertain"
    },
    "navigation_press": {
      "accept_rule": "NAV_STABLE_SEMANTIC_TRANSITION",
      "required_witnesses": [
        "terminal_semantics_stable",
        "cross_context_transition_or_same_context_page_change"
      ],
      "optional_witnesses": ["package_changed", "activity_changed", "route_changed", "page_content_changed", "terminal_pixels_stable", "pixels_changed"],
      "vetoes": [
        "stable_noop",
        "terminal_semantic_instability",
        "contradictory_context_identity",
        "pixel_only_change"
      ],
      "missing_behavior": "uncertain"
    }
  },
  "authority": {
    "pixel_can_authorize_accept": false,
    "task_or_app_literals_can_authorize_accept": false,
    "resolver_only_authorizes_open_app_target": true,
    "labels_visible_to_oracle": false
  }
}

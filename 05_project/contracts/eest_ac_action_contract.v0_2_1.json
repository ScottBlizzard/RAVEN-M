{
  "schema_version": "eest_ac_action_contract.v0_2_1",
  "coordinate_convention": {
    "domain": [0.0, 1.0],
    "left": "x decreases",
    "right": "x increases",
    "up": "y decreases",
    "down": "y increases",
    "clamp": false
  },
  "normalization": {
    "default_swipe_duration_ms": 500,
    "allowed_press_keys": {
      "back": "press_back",
      "home": "press_home",
      "enter": "press_enter"
    },
    "unsupported_press_keys": ["recent_app"],
    "swipe_aliases": ["direction_distance", "signed_delta"]
  },
  "actions": [
    {
      "type": "tap",
      "phase": "continue",
      "required": ["type", "x", "y"],
      "optional": [],
      "fields": {
        "x": {"kind": "coordinate"},
        "y": {"kind": "coordinate"}
      },
      "example": {"type": "tap", "x": 0.5, "y": 0.5},
      "adapter_operation": "click"
    },
    {
      "type": "long_press",
      "phase": "continue",
      "required": ["type", "x", "y", "duration_ms"],
      "optional": [],
      "fields": {
        "x": {"kind": "coordinate"},
        "y": {"kind": "coordinate"},
        "duration_ms": {"kind": "integer", "minimum": 300, "maximum": 3000}
      },
      "example": {"type": "long_press", "x": 0.5, "y": 0.5, "duration_ms": 800},
      "adapter_operation": "adb_long_press"
    },
    {
      "type": "swipe",
      "phase": "continue",
      "required": ["type", "x", "y", "x2", "y2", "duration_ms"],
      "optional": [],
      "fields": {
        "x": {"kind": "coordinate"},
        "y": {"kind": "coordinate"},
        "x2": {"kind": "coordinate"},
        "y2": {"kind": "coordinate"},
        "duration_ms": {"kind": "integer", "minimum": 100, "maximum": 3000}
      },
      "example": {"type": "swipe", "x": 0.5, "y": 0.8, "x2": 0.5, "y2": 0.2, "duration_ms": 500},
      "adapter_operation": "adb_swipe"
    },
    {
      "type": "type_text",
      "phase": "continue",
      "required": ["type", "text", "clear_text"],
      "optional": ["x", "y"],
      "fields": {
        "text": {"kind": "string", "minLength": 1, "maxLength": 64},
        "clear_text": {"kind": "boolean"},
        "x": {"kind": "coordinate"},
        "y": {"kind": "coordinate"}
      },
      "dependent_required": {"x": ["y"], "y": ["x"]},
      "example": {"type": "type_text", "text": "value", "clear_text": true},
      "adapter_operation": "input_text"
    },
    {
      "type": "press_back",
      "phase": "continue",
      "required": ["type"],
      "optional": [],
      "fields": {},
      "example": {"type": "press_back"},
      "adapter_operation": "navigate_back"
    },
    {
      "type": "press_home",
      "phase": "continue",
      "required": ["type"],
      "optional": [],
      "fields": {},
      "example": {"type": "press_home"},
      "adapter_operation": "navigate_home"
    },
    {
      "type": "press_enter",
      "phase": "continue",
      "required": ["type"],
      "optional": [],
      "fields": {},
      "example": {"type": "press_enter"},
      "adapter_operation": "keyboard_enter"
    },
    {
      "type": "open_app",
      "phase": "continue",
      "required": ["type", "app_name"],
      "optional": [],
      "fields": {
        "app_name": {"kind": "string", "minLength": 1, "maxLength": 48}
      },
      "example": {"type": "open_app", "app_name": "ExampleApp"},
      "adapter_operation": "open_app"
    },
    {
      "type": "answer",
      "phase": "done",
      "required": ["type", "text"],
      "optional": [],
      "fields": {
        "text": {"kind": "string", "minLength": 1, "maxLength": 64}
      },
      "example": {"type": "answer", "text": "observed answer"},
      "adapter_operation": "interaction_cache_answer"
    },
    {
      "type": "wait",
      "phase": "continue",
      "required": ["type", "duration_ms"],
      "optional": [],
      "fields": {
        "duration_ms": {"kind": "integer", "minimum": 250, "maximum": 3000}
      },
      "example": {"type": "wait", "duration_ms": 1000},
      "adapter_operation": "sleep"
    }
  ]
}

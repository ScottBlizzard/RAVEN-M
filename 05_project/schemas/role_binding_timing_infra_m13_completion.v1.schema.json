{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven-m.local/schemas/role_binding_timing_infra_m13_completion.v1.schema.json",
  "title": "INFRA-M13 post-diagnosis DEV engineering completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_id",
    "contract_kind",
    "frozen_commit",
    "frozen_tag",
    "status",
    "verdict",
    "first_broken_edge",
    "implementation_binding",
    "canonical_view_gate",
    "issuer_ledger_gate",
    "live_chain",
    "accounting",
    "contamination",
    "protected_wip_sha256",
    "claim_evidence_boundary"
  ],
  "properties": {
    "schema": {
      "const": "role_binding_timing.infra_m13.post_diagnosis_dev_contract.completion.v1"
    },
    "protocol_id": {
      "const": "INFRA-M13-POST-DIAGNOSIS-PROOF-BINDING-ISSUER-LEDGER-V1"
    },
    "contract_kind": {
      "const": "POST_DIAGNOSIS_DEV_ENGINEERING_CONTRACT"
    },
    "frozen_commit": {"$ref": "#/$defs/gitOid"},
    "frozen_tag": {"const": "role-binding-timing-infra-m13-freeze-20260805"},
    "status": {
      "enum": ["NOT_RUN", "FAIL_OFFLINE", "FAIL_LIVE", "PASS_DEV_QUALIFICATION"]
    },
    "verdict": {
      "enum": [
        "NOT_AUTHORIZED",
        "FAIL_CANONICAL_VIEW_BINDING",
        "FAIL_ISSUER_LEDGER",
        "FAIL_INFRASTRUCTURE",
        "ELIGIBLE_TO_PREPARE_NOT_EXECUTE_V0_3"
      ]
    },
    "first_broken_edge": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "code", "recorded_at_utc", "evidence_sha256"],
          "properties": {
            "phase": {"type": "string", "minLength": 1},
            "code": {"type": "string", "minLength": 1},
            "recorded_at_utc": {"type": "string", "format": "date-time"},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "implementation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "contract_sha256",
        "implementation_sha256",
        "implementation_blob_oid",
        "public_sha_authority"
      ],
      "properties": {
        "contract_version": {"const": "infra-m13-proof-bound-role-views-v1"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_blob_oid": {"$ref": "#/$defs/gitOid"},
        "public_sha_authority": {"const": false}
      }
    },
    "canonical_view_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "passed",
        "exact_partition_equality",
        "exact_ancestry_equality",
        "rehash_tamper_accepts",
        "extra_missing_field_accepts",
        "m12_role_matrix_retained",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "executed": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "exact_partition_equality": {"type": "boolean"},
        "exact_ancestry_equality": {"type": "boolean"},
        "rehash_tamper_accepts": {"const": 0},
        "extra_missing_field_accepts": {"const": 0},
        "m12_role_matrix_retained": {"const": true},
        "stdout_sha256": {"$ref": "#/$defs/nullableSha256"},
        "stderr_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "issuer_ledger_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "passed",
        "blocked_by_canonical_view_gate",
        "forged_attestation_accepts",
        "modified_rehashed_accepts",
        "empty_ledger_accepts",
        "post_terminal_accepts",
        "birth_mismatch_accepts",
        "m12_temporal_matrix_retained",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "executed": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "blocked_by_canonical_view_gate": {"type": "boolean"},
        "forged_attestation_accepts": {"const": 0},
        "modified_rehashed_accepts": {"const": 0},
        "empty_ledger_accepts": {"const": 0},
        "post_terminal_accepts": {"const": 0},
        "birth_mismatch_accepts": {"const": 0},
        "m12_temporal_matrix_retained": {"const": true},
        "stdout_sha256": {"$ref": "#/$defs/nullableSha256"},
        "stderr_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "live_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "attempt_count", "same_version_retries", "dev_grid_successes"],
      "properties": {
        "executed": {"type": "boolean"},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "same_version_retries": {"const": 0},
        "dev_grid_successes": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_calls",
        "generation_tokens",
        "held_out_captures",
        "stage1_runs",
        "destination_first_gate_runs"
      ],
      "properties": {
        "generation_calls": {"const": 0},
        "generation_tokens": {"const": 0},
        "held_out_captures": {"const": 0},
        "stage1_runs": {"const": 0},
        "destination_first_gate_runs": {"const": 0}
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_executed", "gate_passed", "excluded_paths_opened", "excluded_import_edges", "excluded_exact_copies"],
      "properties": {
        "gate_executed": {"type": "boolean"},
        "gate_passed": {"type": "boolean"},
        "excluded_paths_opened": {"const": 0},
        "excluded_import_edges": {"const": 0},
        "excluded_exact_copies": {"const": 0}
      }
    },
    "protected_wip_sha256": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "claim_evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "unsupported", "independent_preregistration", "v0_3_action"],
      "properties": {
        "supported": {"type": "array", "items": {"type": "string"}},
        "unsupported": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "independent_preregistration": {"const": false},
        "v0_3_action": {"enum": ["NOT_AUTHORIZED", "PREPARE_ONLY_NOT_EXECUTE"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven-m.local/schemas/role_binding_timing_infra_m11_completion.v1.schema.json",
  "title": "INFRA-M11 terminal completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_id",
    "frozen_commit",
    "frozen_tag",
    "status",
    "verdict",
    "first_broken_edge",
    "phase_journal",
    "offline_gates",
    "live_chain",
    "attestation_audit",
    "accounting",
    "contamination",
    "protected_wip_sha256",
    "predecessor_objects",
    "cleanup",
    "claim_evidence_boundary"
  ],
  "properties": {
    "schema": {
      "const": "role_binding_timing.infra_m11_prereg_first_recovery.completion.v1"
    },
    "protocol_id": {
      "const": "INFRA-M11-PREREG-FIRST-TEMPORAL-SUPPORT-ATTESTATION-RECOVERY-V1"
    },
    "frozen_commit": {
      "$ref": "#/$defs/gitOid"
    },
    "frozen_tag": {
      "const": "role-binding-timing-infra-m11-freeze-20260805"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "FAIL_OFFLINE",
        "FAIL_LIVE",
        "PASS_DEV_QUALIFICATION"
      ]
    },
    "verdict": {
      "enum": [
        "NOT_ELIGIBLE",
        "FAIL_TEMPORAL_ATTESTATION",
        "FAIL_INFRASTRUCTURE",
        "ELIGIBLE_TO_PREPARE_NOT_EXECUTE_V0_3"
      ]
    },
    "first_broken_edge": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/firstBrokenEdge"
        }
      ]
    },
    "phase_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "entry_count",
        "journal_sha256",
        "first_edge_immutable"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "journal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "first_edge_immutable": {
          "const": true
        }
      }
    },
    "offline_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "passed",
        "test_count",
        "failure_count",
        "contamination_gate_passed",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "contamination_gate_passed": {
          "type": "boolean"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "live_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "attempt_count",
        "same_protocol_retries",
        "exclusive_5038",
        "port_5037_observations",
        "burn_in_cycles_completed",
        "burn_in_elapsed_seconds",
        "settings_a11y_successes",
        "dev_grid_successes",
        "dev_grid_total",
        "phases"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "same_protocol_retries": {
          "const": 0
        },
        "exclusive_5038": {
          "type": "boolean"
        },
        "port_5037_observations": {
          "const": 0
        },
        "burn_in_cycles_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "burn_in_elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "settings_a11y_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "dev_grid_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "dev_grid_total": {
          "const": 12
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phaseResult"
          }
        }
      }
    },
    "attestation_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "terminal_expired",
        "issued_count",
        "verified_count",
        "rejected_count",
        "cross_sample_accepts",
        "cross_run_accepts",
        "current_history_conflict_accepts",
        "support_authority_violations",
        "controlled_port_support_violations",
        "records"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "terminal_expired": {
          "type": "boolean"
        },
        "issued_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_sample_accepts": {
          "const": 0
        },
        "cross_run_accepts": {
          "const": 0
        },
        "current_history_conflict_accepts": {
          "const": 0
        },
        "support_authority_violations": {
          "const": 0
        },
        "controlled_port_support_violations": {
          "const": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestationRecord"
          }
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_calls",
        "generation_tokens",
        "held_out_captures",
        "stage1_runs",
        "destination_first_runs"
      ],
      "properties": {
        "generation_calls": {
          "const": 0
        },
        "generation_tokens": {
          "const": 0
        },
        "held_out_captures": {
          "const": 0
        },
        "stage1_runs": {
          "const": 0
        },
        "destination_first_runs": {
          "const": 0
        }
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_executed",
        "gate_passed",
        "leaked_file_read",
        "leaked_file_imported",
        "leaked_content_hash_matches"
      ],
      "properties": {
        "gate_executed": {
          "type": "boolean"
        },
        "gate_passed": {
          "type": "boolean"
        },
        "leaked_file_read": {
          "const": false
        },
        "leaked_file_imported": {
          "const": false
        },
        "leaked_content_hash_matches": {
          "const": 0
        }
      }
    },
    "protected_wip_sha256": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "predecessor_objects": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "$ref": "#/$defs/gitOid"
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "completed",
        "support_target_count",
        "controlled_port_residue_count",
        "errors"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "support_target_count": {
          "const": 0
        },
        "controlled_port_residue_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim_evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "unsupported",
        "v0_3_action"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "v0_3_action": {
          "enum": [
            "NOT_AUTHORIZED",
            "PREPARE_ONLY_NOT_EXECUTE"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "firstBrokenEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "code",
        "sample_sequence",
        "recorded_at_utc",
        "evidence_sha256"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "sample_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "phaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "started_at_utc",
        "ended_at_utc",
        "evidence_sha256"
      ],
      "properties": {
        "phase": {
          "enum": [
            "exclusive_5038",
            "launch",
            "boot",
            "display_framework",
            "burn_in",
            "settings_a11y",
            "dev_grid",
            "cleanup",
            "seal"
          ]
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL"
          ]
        },
        "started_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "attestationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "sample_sequence",
        "candidate_identity_key",
        "source_snapshot_sha256",
        "partition_sha256",
        "chain_record_sha256",
        "decision",
        "authority_granted",
        "historical_only"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_identity_key": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "partition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "chain_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "enum": [
            "ACCEPT_BIRTH_PROVENANCE",
            "ACCEPT_HISTORICAL_CLASSIFICATION_ONLY",
            "REJECT"
          ]
        },
        "authority_granted": {
          "type": "boolean"
        },
        "historical_only": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaglelab.example/raven-m/plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_subgoal",
    "open_requirements",
    "required_variables",
    "completion_requirements",
    "plan_summary"
  ],
  "properties": {
    "schema_version": {"const": "plan.v1"},
    "current_subgoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subgoal_id", "description"],
      "properties": {
        "subgoal_id": {"type": "string", "pattern": "^sg_[0-9]{2,}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "open_requirements": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 240}
    },
    "required_variables": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 120}
    },
    "completion_requirements": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "evidence_memory_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^cr_[0-9]{1,}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 240},
          "evidence_memory_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[mf]_[0-9]{4,}$"}
          }
        }
      }
    },
    "plan_summary": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaglelab.example/eest-ac/decision.v0_1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "action",
    "expected_outcome",
    "decision_summary",
    "observed_evidence",
    "evidence_citations"
  ],
  "properties": {
    "status": {"enum": ["continue", "done", "fail"]},
    "action": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/action"}
      ]
    },
    "expected_outcome": {"type": "string", "minLength": 1, "maxLength": 240},
    "decision_summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "observed_evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "evidence_citations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(ev:|task:)"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "continue"}}, "required": ["status"]},
      "then": {"properties": {"action": {"$ref": "#/$defs/action"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["done", "fail"]}}, "required": ["status"]},
      "then": {"properties": {"action": {"type": "null"}}}
    }
  ],
  "$defs": {
    "coordinate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "field", "value", "scope", "relevance_tags"],
      "properties": {
        "entity": {"type": "string", "minLength": 1, "maxLength": 160},
        "field": {"type": "string", "minLength": 1, "maxLength": 120},
        "value": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope": {"enum": ["current_page", "cross_page", "episode"]},
        "relevance_tags": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y"],
          "properties": {
            "type": {"const": "tap"},
            "x": {"$ref": "#/$defs/coordinate"},
            "y": {"$ref": "#/$defs/coordinate"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "duration_ms"],
          "properties": {
            "type": {"const": "long_press"},
            "x": {"$ref": "#/$defs/coordinate"},
            "y": {"$ref": "#/$defs/coordinate"},
            "duration_ms": {"type": "integer", "minimum": 300, "maximum": 3000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "x2", "y2", "duration_ms"],
          "properties": {
            "type": {"const": "swipe"},
            "x": {"$ref": "#/$defs/coordinate"},
            "y": {"$ref": "#/$defs/coordinate"},
            "x2": {"$ref": "#/$defs/coordinate"},
            "y2": {"$ref": "#/$defs/coordinate"},
            "duration_ms": {"type": "integer", "minimum": 100, "maximum": 3000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "clear_text"],
          "properties": {
            "type": {"const": "type_text"},
            "text": {"type": "string", "minLength": 1, "maxLength": 1000},
            "x": {"$ref": "#/$defs/coordinate"},
            "y": {"$ref": "#/$defs/coordinate"},
            "clear_text": {"type": "boolean"}
          },
          "dependentRequired": {"x": ["y"], "y": ["x"]}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["press_back", "press_home", "press_enter"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "app_name"],
          "properties": {
            "type": {"const": "open_app"},
            "app_name": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "answer"},
            "text": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "duration_ms"],
          "properties": {
            "type": {"const": "wait"},
            "duration_ms": {"type": "integer", "minimum": 250, "maximum": 5000}
          }
        }
      ]
    }
  }
}

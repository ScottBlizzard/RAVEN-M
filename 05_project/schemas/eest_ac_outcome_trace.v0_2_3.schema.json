{
  "$id": "https://eaglelab.example/eest-ac/outcome-trace.v0_2_3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "minProperties": 1,
      "type": "object"
    },
    "action_class": {
      "enum": [
        "scroll",
        "open_app",
        "navigation_press"
      ]
    },
    "post": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "a11y_available": {
            "type": "boolean"
          },
          "a11y_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            ]
          },
          "activity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "package_names": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "page_content_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            ]
          },
          "pixel_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "route_signature": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "pixel_sha256",
          "a11y_available",
          "a11y_sha256",
          "page_content_sha256",
          "package_names",
          "activity",
          "route_signature"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 2,
      "type": "array"
    },
    "pre": {
      "additionalProperties": false,
      "properties": {
        "a11y_available": {
          "type": "boolean"
        },
        "a11y_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "activity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "package_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "page_content_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "pixel_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "route_signature": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "pixel_sha256",
        "a11y_available",
        "a11y_sha256",
        "page_content_sha256",
        "package_names",
        "activity",
        "route_signature"
      ],
      "type": "object"
    },
    "resolver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provenance_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              ]
            },
            "target_activities": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "target_packages": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "target_packages",
            "target_activities",
            "provenance_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "action_class",
    "action",
    "resolver",
    "pre",
    "post"
  ],
  "type": "object"
}
